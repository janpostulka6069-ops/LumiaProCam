<Page x:Class="LumiaProCam.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
      Background="Black">
    <Grid>
        <canvas:CanvasControl x:Name="PreviewCanvas" Draw="PreviewCanvas_Draw" />

        <StackPanel VerticalAlignment="Top" Background="#99000000" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="BtnStream" Grid.Column="0" Content="Online IP" HorizontalAlignment="Stretch" Margin="2" FontSize="11" Click="BtnStream_Click"/>
                <ToggleButton x:Name="BtnHorizon" Grid.Column="1" Content="360 Lock" HorizontalAlignment="Stretch" Margin="2" FontSize="11"/>
                <ToggleButton x:Name="BtnMoon" Grid.Column="2" Content="Moon" HorizontalAlignment="Stretch" Margin="2" FontSize="11" Click="BtnMoon_Click"/>
                <ToggleButton x:Name="BtnSharp" Grid.Column="3" Content="Sharp+" IsChecked="True" HorizontalAlignment="Stretch" Margin="2" FontSize="11"/>
            </Grid>
            <TextBlock x:Name="TxtStatus" Foreground="Lime" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Text="Pripraveno"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" Background="#BB000000" Padding="10">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ostreni:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="SliderFocus" Grid.Column="1" Minimum="0" Maximum="1000" Value="500" ValueChanged="SliderFocus_ValueChanged"/>
            </Grid>

            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtZoom" Text="Zoom 1x:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="SliderZoom" Grid.Column="1" Minimum="1" Maximum="120" Value="1" ValueChanged="SliderZoom_ValueChanged"/>
            </Grid>

            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ISO:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="SliderIso" Grid.Column="1" Minimum="50" Maximum="3200" Value="200" ValueChanged="SliderIso_ValueChanged"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPhoto" Grid.Column="0" Content="FOTIT" HorizontalAlignment="Stretch" Height="48" Margin="4" Background="#0078D7" Foreground="White" Click="BtnPhoto_Click"/>
                <Button x:Name="BtnRecord" Grid.Column="1" Content="REC VIDEO" HorizontalAlignment="Stretch" Height="48" Margin="4" Background="#D13438" Foreground="White" Click="BtnRecord_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
